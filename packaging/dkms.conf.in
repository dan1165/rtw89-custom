PACKAGE_NAME="rtw89-custom"
PACKAGE_VERSION="@VERSION@"
CLEAN="make -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build clean"
BUILT_MODULE_NAME[0]="rtw89_core"
BUILT_MODULE_NAME[1]="rtw89_usb"
BUILT_MODULE_NAME[2]="rtw89_8851b"
BUILT_MODULE_NAME[3]="rtw89_8851bu"
DEST_MODULE_LOCATION[0]="/updates/drivers/net/wireless/realtek/rtw89"
DEST_MODULE_LOCATION[1]="/updates/drivers/net/wireless/realtek/rtw89"
DEST_MODULE_LOCATION[2]="/updates/drivers/net/wireless/realtek/rtw89"
DEST_MODULE_LOCATION[3]="/updates/drivers/net/wireless/realtek/rtw89"
AUTOINSTALL="yes"
